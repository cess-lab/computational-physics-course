# Created by https://www.toptal.com/developers/gitignore/api/matlab
# Edit at https://www.toptal.com/developers/gitignore?templates=matlab

### MATLAB ###

# Windows default autosave extension
*.asv

# OSX / *nix default autosave extension
*.m~

# Compiled MEX binaries (all platforms)
*.mex*

# Packaged app and toolbox files
*.mlappinstall
*.mltbx

# Generated helpsearch folders
helpsearch*/

# Simulink code generation folders
slprj/
sccprj/

# Matlab code generation folders
codegen/

# Simulink autosave extension
*.autosave

# Simulink cache files
*.slxc

# Octave session info
octave-workspace

# End of https://www.toptal.com/developers/gitignore/api/matlab

# Assessment papers, practice sets, answers, and their source/build assets
/Assessments/Student-facing/Test_*
/Assessments/Student-facing/Final_Examination_*
/Assessments/Student-facing/Individual_Lab_Test_*
/Assessments/Instructor/Test_*
/Assessments/Instructor/Final_Examination_*
/Assessments/Instructor/Individual_Lab_Test_*
/Assessments/[Pp]ractice*/
/Assessments/[Pp]ractise*/
/Assessments/.agent/test-*/
/Assessments/.agent/sample/

# Paper copies in any folder and format (PDF, Markdown, TeX, ZIP, etc.)
*_[Tt]est_[0-9]*
*_[Qq]uestion_[Pp]aper.*
*_[Mm]arking_[Ss]cheme.*
*_[Ee]xamination_[Aa]nswer_[Kk]ey.*

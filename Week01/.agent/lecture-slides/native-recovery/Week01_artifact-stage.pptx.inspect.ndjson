{"kind":"textbox","id":"sh/gre58jap","slide":5,"text":"4","textPreview":"4","textChars":1,"textLines":1,"bbox":[1764,976,40,28]}
{"kind":"textbox","id":"sh/fq5ofet4","slide":5,"text":"Element-wise operators calculate every sample","textPreview":"Element-wise operators calculate every sample","textChars":45,"textLines":1,"bbox":[115,60,1580,92]}
{"kind":"textbox","id":"sh/upwn69cj","slide":5,"text":"The dot tells MATLAB to work value by value","textPreview":"The dot tells MATLAB to work value by value","textChars":43,"textLines":1,"bbox":[115,152,1580,44]}
{"kind":"shape","id":"sh/pg76lob6","slide":5,"bbox":[120,310,1550,120]}
{"kind":"textbox","id":"sh/ofy5cja1","slide":5,"text":"y_m = y0_m + v0_mps.*t_s - 0.5*g_mps2.*t_s.^2;","textPreview":"y_m = y0_m + v0_mps.*t_s - 0.5*g_mps2.*t_s.^2;","textChars":46,"textLines":1,"bbox":[148,335,1494,75]}
{"kind":"textbox","id":"sh/3u5ojetg","slide":5,"text":"Use .* and .^ when both sides contain arrays.","textPreview":"Use .* and .^ when both sides contain arrays.","textChars":45,"textLines":1,"bbox":[120,510,1400,70]}
{"kind":"notes","id":"nt/8nn0ye","slide":5,"text":"[Sources]\n- PHY4605 Week materials and retained course assets\n[/Sources]"}

{"kind":"textbox","id":"sh/apcnex4f","slide":7,"text":"Trace one value before trusting the whole array","textPreview":"Trace one value before trusting the whole array","textChars":47,"textLines":1,"bbox":[115,60,1580,92]}
{"kind":"textbox","id":"sh/bql4n250","slide":7,"text":"At index 1, time is 0 s","textPreview":"At index 1, time is 0 s","textChars":23,"textLines":1,"bbox":[115,152,1580,44]}

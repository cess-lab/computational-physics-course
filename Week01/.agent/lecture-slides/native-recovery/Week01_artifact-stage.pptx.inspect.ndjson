{"kind":"textbox","id":"sh/r21cfyxk","slide":6,"text":"A labelled plot lets us test the prediction","textPreview":"A labelled plot lets us test the prediction","textChars":43,"textLines":1,"bbox":[115,60,1580,92]}
{"kind":"textbox","id":"sh/qhsbmtgz","slide":6,"text":"Axes and units make the result interpretable","textPreview":"Axes and units make the result interpretable","textChars":44,"textLines":1,"bbox":[115,152,1580,44]}
{"kind":"shape","id":"sh/5gjudofe","slide":6,"bbox":[250,280,1180,540]}
{"kind":"textbox","id":"sh/4fatkjyt","slide":6,"text":"height y (m)","textPreview":"height y (m)","textChars":12,"textLines":1,"bbox":[320,350,260,44]}
{"kind":"textbox","id":"sh/3e1cbex8","slide":6,"text":"time t (s)","textPreview":"time t (s)","textChars":10,"textLines":1,"bbox":[860,740,240,44]}

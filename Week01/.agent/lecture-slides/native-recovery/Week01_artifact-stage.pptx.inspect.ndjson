{"kind":"textbox","id":"sh/adkry1of","slide":8,"text":"Modify one input and compare the physical result","textPreview":"Modify one input and compare the physical result","textChars":48,"textLines":1,"bbox":[115,60,1580,92]}
{"kind":"textbox","id":"sh/bet8r6p0","slide":8,"text":"A larger launch speed should increase the peak height","textPreview":"A larger launch speed should increase the peak height","textChars":53,"textLines":1,"bbox":[115,152,1580,44]}
{"kind":"shape","id":"sh/kjm94b6h","slide":8,"bbox":[130,280,540,76]}
{"kind":"textbox","id":"sh/lkvqxg72","slide":8,"text":"1. Keep y0 and g fixed","textPreview":"1. Keep y0 and g fixed","textChars":22,"textLines":1,"bbox":[154,299,492,38]}
{"kind":"shape","id":"sh/yh4r21or","slide":8,"bbox":[130,384,540,76]}

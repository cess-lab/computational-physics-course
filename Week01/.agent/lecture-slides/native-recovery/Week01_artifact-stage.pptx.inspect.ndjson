{"kind":"textbox","id":"sh/alozmd0v","slide":11,"text":"What should the curve show at launch, peak, and return?","textPreview":"What should the curve show at launch, peak, and return?","textChars":55,"textLines":1,"bbox":[115,152,1580,44]}
{"kind":"textbox","id":"sh/lszilszi","slide":11,"text":"Use the graph to support a claim about the ball’s motion—not just to report that it “looks right”.","textPreview":"Use the graph to support a claim about the ball’s motion—not just to report that it “looks right”.","textChars":98,"textLines":1,"bbox":[170,340,1460,120]}

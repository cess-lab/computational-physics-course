{"kind":"textbox","id":"sh/zq94behs","slide":8,"text":"Controlled comparison: change one thing, then explain one change in the graph.","textPreview":"Controlled comparison: change one thing, then explain one change in the graph.","textChars":78,"textLines":1,"bbox":[850,420,780,120]}

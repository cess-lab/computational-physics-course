{"kind":"shape","id":"sh/0nips7qd","slide":8,"bbox":[130,488,540,76]}
{"kind":"textbox","id":"sh/1obqlc7y","slide":8,"text":"3. Recalculate the array","textPreview":"3. Recalculate the array","textChars":24,"textLines":1,"bbox":[154,507,492,38]}
{"kind":"shape","id":"sh/lsrmdozy","slide":8,"bbox":[130,592,540,76]}

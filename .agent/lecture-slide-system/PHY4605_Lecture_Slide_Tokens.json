      "courseTag": "PHY4605 Computational Methods in Physics",
      "openingTitleRule": "Individual deck title in Title Case; master exemplar: Physics to Arrays and Plots",
      "openingSubtitleRule": "Week N | followed by a short, topic-specific tagline; master exemplar: Week 1 | From Motion to MATLAB",

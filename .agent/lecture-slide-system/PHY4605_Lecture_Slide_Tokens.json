      "T1",
      "T2",
      "T3",
      "body-hierarchy",
      "code",
      "equation",
      "plot",
      "comparison",
      "validation",
      "generated-visual-frame"
    ]
  },
  "equations": {
    "renderer": "render-equations-diagrams",
    "displayEquationRoute": "latex-rendered-asset",
    "displayEquationScope": [
      "standalone-formula",
      "equation-fragment",
      "indexed-expression",
      "symbol-with-subscript-or-superscript",
      "symbol-plus-unit-expression"
    ],
    "editableTextExceptions": [
      "ordinary-prose",
      "MATLAB-code",
      "chart-axis-label",
      "chart-legend-label"
    ],
    "forbidPlainPowerPointText": true,
    "forbidImageGen": true,
    "preferredFormat": "transparent-svg-when-preserved",
    "fallbackFormat": "high-resolution-transparent-png",
    "minimumPngRenderScale": 6,
    "defaultForeground": "#0B2B4C",
    "requiredProvenance": ["tex", "svg", "png", "altText", "foreground", "displaySize", "fitOrCrop", "qa"],
    "surroundingLabelsEditable": true
  },
  "qa": {
    "fontPreflightRequired": true,
    "fontSubstitutionAllowed": false,
    "renderEverySlide": true,
    "inspectEverySlideAtFullSize": true,
    "titleContactSheetRequired": true,
    "fullDeckContactSheetRequired": true,
    "overflowCheckRequired": true,
    "overlapCheckRequired": true,
    "editableObjectCheckRequired": true,
    "speakerNotesCheckRequired": true,
    "hashBoundApprovalRequired": true,
